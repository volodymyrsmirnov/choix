{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node", "vite/client"],
    "paths": {
      "@bindings/*": ["./bindings/github.com/volodymyrsmirnov/choix/internal/app/*"]
    }
  },
  "include": ["src", "prototype", "tools", "e2e", "*.ts", "bindings"],
  "exclude": ["node_modules", "dist", "dist-prototype", ".design", "e2e/harness/dist"]
}
