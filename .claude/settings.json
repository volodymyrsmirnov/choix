{
  "permissions": {
    "deny": [
      "Edit(/docs/design/approvals.json)",
      "Edit(/docs/design/approvers.txt)",
      "Edit(**/docs/design/approvals.json)",
      "Edit(**/docs/design/approvers.txt)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py pre-edit",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py pre-bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py post-bash",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py post-bash",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py post-bash",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py post-bash",
            "timeout": 60
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py denied",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py denied",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design_gate.py subagent-stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
